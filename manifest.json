{
  "manifest_version": 3,
  "name": "Type-Pause Video",
  "version": "1.0",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Toggle auto-pause while typing" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" } }
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true }
  ]
}